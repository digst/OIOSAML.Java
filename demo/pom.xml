<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <artifactId>oiosaml3-demo</artifactId>
    <name>OIOSAML Demo for Java v3</name>
    <modelVersion>4.0.0</modelVersion>
    <packaging>war</packaging>

    <parent>
        <artifactId>oiosaml3-parent</artifactId>
        <groupId>dk.digst</groupId>
        <version>3.2.3-SNAPSHOT</version>
    </parent>

    <build>
        <plugins>
            <!-- Jetty 9.4 is a Servlet 3.1 container, which the library requires. Tomcat 7, used here
                 before, only implements Servlet 3.0 -->
            <plugin>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-maven-plugin</artifactId>
                <version>9.4.53.v20231009</version>
                <configuration>
                    <webApp>
                        <contextPath>/oiosaml3-demo.java</contextPath>
                    </webApp>
                    <jettyXml>${project.basedir}/src/main/jetty/jetty-https.xml</jettyXml>
                    <systemProperties>
                        <systemProperty>
                            <name>demo.keystore.path</name>
                            <value>${project.basedir}/../misc/ssl-demo.pfx</value>
                        </systemProperty>
                        <systemProperty>
                            <name>demo.keystore.password</name>
                            <value>Test1234</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>
        </plugins>

        <finalName>oiosaml3-demo.java</finalName>
    </build>

    <dependencies>
        <dependency>
            <groupId>javax.servlet.jsp.jstl</groupId>
            <artifactId>javax.servlet.jsp.jstl-api</artifactId>
            <version>1.2.2</version>
        </dependency>

        <dependency>
            <groupId>taglibs</groupId>
            <artifactId>standard</artifactId>
            <version>1.1.2</version>
        </dependency>

        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>dk.digst</groupId>
            <artifactId>oiosaml3.java</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Write all logging to Log4j2 -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j-impl</artifactId>
            <version>2.17.1</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.32</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jcl-over-slf4j</artifactId>
            <version>1.7.32</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>log4j-over-slf4j</artifactId>
            <version>1.7.32</version>
        </dependency>

    </dependencies>
</project>
